<?xml version="1.0"?>
<sdf version="1.10">
  <model name="focus_v2">
    <!-- Physics is provided by the external xdyn co-simulation (see focus_v2.yaml);
         Gazebo only carries the visual + a coarse collision box. -->
    <link name="base_link">
      <visual name="visual">
        <!-- OBJ renders in the Gazebo GUI (the Blender COLLADA loader fails
             silently in gz-common). Mesh is modelled bow on +Y to match the
             vessel advance axis in the link frame. -->
        <geometry>
          <mesh>
            <uri>model://focus_v2/meshes/focus_v2.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.17 0.995 0.13</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
