<?xml version="1.0"?>
<model>
  <name>focus_v2</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>

  <author>
    <name>Cyril Moron</name>
  </author>

  <description>
    Joysway Focus V2 — a 1 metre class RC sailboat (hull, fin keel + lead bulb,
    rudder, mast and sails). Geometry and the xdyn dynamic model are authored
    from published dimensions; the hydro/aero coefficients are engineering
    estimates pending naval-engineer validation. EPL-2.0.
  </description>
</model>
